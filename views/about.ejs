<%- include('partials/header') %>

<section class="container py-5">

    <h1 class="text-center mb-5">Get to Know Me</h1>

    <div class="row align-items-center">

        <div class="col-lg-5 text-center mb-4">

            <img src="/images/Ahmed-profile.png"
                 alt="Ahmed Sher profile photograph"
                 class="img-fluid rounded shadow"
                 style="max-width: 350px;">

        </div>

        <div class="col-lg-7">

            <h2>Hello, I'm Ahmed!</h2>

            <p class="lead mt-3">
                My name is Ahmed Sher, and welcome to my
                personal portfolio. I am a student who
                enjoys learning new skills, exploring
                technology, and challenging myself
                through new experiences.
            </p>

            <p>
                This website gives you a closer look
                at who I am, my interests, and some
                of the academic projects I have completed.
            </p>

            <h3 class="mt-4">My Interests</h3>

            <p>
                Outside of school, I enjoy spending
                time with friends and family,
                exploring new places, and making memories.
            </p>

        </div>

    </div>

</section>

<section class="container py-5 text-center">

    <h2>My Introduction Video</h2>

    <p class="mt-3">
        Watch my short introduction video
        to learn more about me.
    </p>

    <video controls
           poster="/images/Ahmed-profile.png"
           class="img-fluid rounded shadow mt-3"
           style="max-width: 650px; width: 100%;">

        <source src="/images/ahmed.intro.mp4"
                type="video/mp4">

        Your browser does not support HTML5 video.

    </video>

</section>

<%- include('partials/footer') %>
